# Copy to .env for local development. Never commit .env.
# Leave DATABASE_URL unset locally to use SQLite at instance/local.db.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=change-me-to-a-long-random-string
APP_PASSWORD=change-me
MOXFIELD_USERNAME=mirkwoodrunner
# Optional. Contact shown to Scryfall in the User-Agent. Defaults to the repo URL.
# SCRYFALL_CONTACT=https://github.com/mirkwoodrunner/game-night-bag
